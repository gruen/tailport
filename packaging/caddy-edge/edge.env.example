# tailport Caddy edge — deploy variables (see the Appendix in docs/caddy-edge.md).
#
# Copy this to `edge.env` (gitignored), fill it in, and load it in the shell you
# deploy from — re-source it in any new shell instead of retyping the values:
#
#     cp edge.env.example edge.env
#     $EDITOR edge.env
#     . ./edge.env            # `source edge.env` in bash
#
# These are NOT secrets. The one real secret, TS_AUTHKEY, is set separately with
# `fly secrets set` and must NEVER go in this file. `edge.env` matches the
# gitignore's `*.env` rule so it can't be committed; this `.example` is tracked.

APP=my-tailport-edge      # Fly app name — globally unique across all of Fly; pick anything free
REGION=iad                # Fly region id (`fly platform regions`), near your visitors
DOMAIN=example.com        # your public base domain → tailport's caddy.domain (§4)
HOSTNAME=caddy            # the edge's TAILNET name → tailport's caddy.hostname (§4); default `caddy`
TAG=tag:tailport-edge     # the Tailscale ACL tag the edge registers under (§1)
